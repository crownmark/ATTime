@page "/add-form"
@attribute [Authorize]

<PageTitle>Add Form</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save Form</RadzenAlert>
        <RadzenTemplateForm TItem="CrownATTime.Server.Models.ATTime.Form" Data="@(form)" Visible="@(form != null)" Submit="@FormSubmit">
          <RadzenStack>
            <RadzenFormField Text="Title" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(form.Title)" Name="Title" MaxLength="500" />
                  </ChildContent>    
                  <Helper>
                    <RadzenRequiredValidator Component="Title" Text="Title is required" />
                  </Helper>
            </RadzenFormField>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Active" Component="Active" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenCheckBox @bind-Value="@(form.Active)" Name="Active" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenFormField Text="Form Category" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenDropDown Data="@(formCategoriesForFormCategoryId)" TextProperty="Title" ValueProperty="FormCategoryId" AllowClear=true
                          style="display: block; width: 100%" @bind-Value="@(form.FormCategoryId)" Name="FormCategoryId"
                         Count=@formCategoriesForFormCategoryIdCount LoadData=@formCategoriesForFormCategoryIdLoadData />
              </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Form Url" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(form.FormUrl)" Name="FormUrl" MaxLength="500" />
                  </ChildContent>    
                  <Helper>
                    <RadzenRequiredValidator Component="FormUrl" Text="FormUrl is required" />
                  </Helper>
            </RadzenFormField>
          </RadzenStack>
          <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

