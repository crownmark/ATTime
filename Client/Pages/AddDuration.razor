@page "/add-duration"

@attribute [Authorize]
<PageTitle>Add Duration</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save Duration</RadzenAlert>
        <RadzenTemplateForm TItem="CrownATTime.Server.Models.ATTime.Duration" Data="@(duration)" Visible="@(duration != null)" Submit="@FormSubmit">
          <RadzenStack>
            <RadzenFormField Text="Duration Type" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenDropDown Data="@(durationTypesForDurationTypeId)" TextProperty="Title" ValueProperty="DurationTypeId" AllowClear=true
                          style="display: block; width: 100%" @bind-Value="@(duration.DurationTypeId)" Name="DurationTypeId"
                         Count=@durationTypesForDurationTypeIdCount LoadData=@durationTypesForDurationTypeIdLoadData />
              </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Title" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(duration.Title)" Name="Title" AutoCompleteType="AutoCompleteType.Off" MaxLength="255" />
                  </ChildContent>    
                  <Helper>
                    <RadzenRequiredValidator Component="Title" Text="Title is required" />
                  </Helper>
            </RadzenFormField>
            <RadzenFormField Text="Value In Minutes" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(duration.ValueInMinutes)" Name="ValueInMinutes" AutoCompleteType="AutoCompleteType.Off"/>
                  </ChildContent>    
                  <Helper>
                    <RadzenRequiredValidator Component="ValueInMinutes" Text="ValueInMinutes is required" />
                  </Helper>
            </RadzenFormField>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Active" Component="Active" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenCheckBox @bind-Value="@(duration.Active)" Name="Active" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenFormField Text="Sort Order" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(duration.SortOrder)" Name="SortOrder" AutoCompleteType="AutoCompleteType.Off"/>
              </ChildContent>
            </RadzenFormField>
          </RadzenStack>
          <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

